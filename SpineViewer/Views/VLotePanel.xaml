<UserControl x:Class="SpineViewer.Views.VLotePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#252932" Foreground="#ECF1FA">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="12">
            <TextBlock Text="VLote 0.1" FontWeight="Bold" FontSize="21" Margin="0,0,0,8"/>
            <TextBlock Text="Pasta raiz (recursiva)" FontWeight="SemiBold"/>
            <TextBox x:Name="RootPath" MinHeight="30" Margin="0,5,0,6"
                     TextWrapping="Wrap" ToolTip="Pasta que contém subpastas com .skel/.json e .atlas"/>
            <WrapPanel Margin="0,0,0,9">
                <Button Content="Abrir pasta..." MinWidth="115" Padding="8,6"
                        Click="Browse_Click"/>
                <Button Content="Ler / Atualizar fila" MinWidth="135" Margin="6,0,0,0"
                        Padding="8,6" Click="Scan_Click"/>
            </WrapPanel>
            <Border Background="#343B49" Padding="9" CornerRadius="4" Margin="0,2,0,12">
                <StackPanel>
                    <TextBlock x:Name="CurrentName" FontSize="14" FontWeight="SemiBold"
                               Text="Nenhuma pasta selecionada" TextWrapping="Wrap"/>
                    <TextBlock x:Name="CurrentPath" Margin="0,6,0,0" Foreground="#BDCCDD"
                               FontSize="11" TextWrapping="Wrap"/>
                    <TextBlock x:Name="Counter" Margin="0,9,0,0" Text="0/0"
                               FontSize="17" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <TextBlock Text="CONFIGURAÇÃO DE EXPORTAÇÃO" FontWeight="Bold" FontSize="13"
                       Margin="0,0,0,7"/>
            <TextBlock Text="O preview central continua editável: ajuste posição, zoom e o fundo antes de exportar."
                       TextWrapping="Wrap" Foreground="#C7D5E7" Margin="0,0,0,10"/>
            <TextBlock Text="Formato"/>
            <ComboBox x:Name="Format" MinHeight="29" Margin="0,3,0,9"/>
            <Grid Margin="0,0,0,7">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                    <TextBlock Text="Largura"/>
                    <TextBox x:Name="OutputWidth" Text="720" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                    <TextBlock Text="Altura"/>
                    <TextBox x:Name="OutputHeight" Text="720" Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>
            <Grid Margin="0,0,0,7">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                    <TextBlock Text="FPS"/>
                    <TextBox x:Name="FramesPerSecond" Text="30" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                    <TextBlock Text="CRF (MP4)"/>
                    <TextBox x:Name="CrfText" Text="23" Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>
            <Grid Margin="0,0,0,7">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                    <TextBlock Text="WebP Quality"/>
                    <TextBox x:Name="QualityText" Text="95" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                    <TextBlock Text="Velocidade"/>
                    <TextBox x:Name="SpeedText" Text="1" Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>

            <CheckBox x:Name="AllAnimations" Content="Exportar TODAS as animações"
                      IsChecked="True" Margin="0,4"/>
            <CheckBox x:Name="Transparent" Content="Fundo transparente (WebP/APNG/MOV)"
                      IsChecked="False" Margin="0,4"/>
            <CheckBox x:Name="AutoFit" Content="Resolução automática (enquadramento pela animação)"
                      IsChecked="False" Margin="0,4"/>
            <CheckBox x:Name="KeepLast" Content="Keep last frame" IsChecked="True" Margin="0,4"/>
            <CheckBox x:Name="Loop" Content="Loop" IsChecked="True" Margin="0,4"/>
            <CheckBox x:Name="Lossless" Content="WebP lossless" Margin="0,4"/>
            <CheckBox x:Name="DisableTrackLoop" Content="Desativar loop interno das tracks" Margin="0,4"/>
            <TextBlock Text="Os vídeos ficam em _VLote_Exports dentro da pasta do modelo, e acompanham os arquivos movidos para _OK."
                       TextWrapping="Wrap" Foreground="#BCCDDD" Margin="0,9,0,12"/>

            <Button x:Name="ExportButton" Content="EXPORTAR → OK"
                    FontSize="16" FontWeight="Bold" MinHeight="52" Margin="0,3,0,7"
                    Background="#266748" Foreground="White" Click="Export_Click"/>
            <Button x:Name="NullButton" Content="NULL → _Null"
                    FontSize="15" FontWeight="Bold" MinHeight="50"
                    Background="#883C42" Foreground="White" Click="Null_Click"/>
            <Button x:Name="CancelButton" Content="Cancelar exportação em andamento"
                    Margin="0,9,0,0" MinHeight="32" IsEnabled="False"
                    Click="Cancel_Click"/>
            <TextBlock x:Name="Detail" Text="Escolha uma pasta raiz para começar."
                       TextWrapping="Wrap" Foreground="#C1D3E6" Margin="0,13,0,20"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
